{%- paginate collection.products by section.settings.products_per_page -%}
  <section
    class="section-padded scheme scheme--{{ section.settings.color_scheme }}"
    style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
  >
    <div class="page-width">
      {% render 'facets',
        results: collection,
        enable_filter: section.settings.enable_filtering,
        enable_sort: section.settings.enable_sorting
      %}

      <div data-collection-results aria-live="polite">
        {%- if collection.products.size > 0 -%}
          <div
            class="product-grid"
            style="--grid-cols-lg: {{ section.settings.columns }}; --grid-cols-md: {{ section.settings.columns | at_most: 3 }}; --grid-cols-sm: {{ section.settings.columns_mobile }};"
          >
            {%- for product in collection.products -%}
              <div class="reveal" style="--reveal-delay: {{ forloop.index0 | modulo: 4 | times: 70 }}ms;">
                {% render 'product-card', product: product, index: forloop.index0 %}
              </div>
            {%- endfor -%}
          </div>

          {% render 'pagination', paginate: paginate, ajax: true %}

        {%- elsif collection.all_products_count > 0 -%}
          <div class="collection-empty">
            {% render 'calyx', size: '3rem', opacity: '0.5' %}
            <p class="h3">{{ 'collections.general.no_matches' | t }}</p>
            <p class="text-body">{{ 'collections.general.no_matches_help' | t }}</p>
            <a href="{{ collection.url }}" class="btn btn--outline" data-facet-remove>
              <span class="btn__label">{{ 'products.facets.clear_all' | t }}</span>
            </a>
          </div>

        {%- else -%}
          <div class="collection-empty">
            {% render 'calyx', size: '3rem', opacity: '0.5' %}
            <p class="h3">{{ 'collections.general.empty' | t }}</p>
            <p class="text-body">{{ 'collections.general.empty_help' | t }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline">
              <span class="btn__label">{{ 'collections.general.browse' | t }}</span>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection grid",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "parchment", "label": "Parchment" },
        { "value": "white", "label": "White" },
        { "value": "alt", "label": "Warm parchment" }
      ],
      "default": "parchment"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Pieces per page",
      "default": 24
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    { "type": "header", "content": "Filtering and sorting" },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "default": true,
      "info": "Filters are managed in Shopify admin under Products › Collections › Filters."
    },
    { "type": "checkbox", "id": "enable_sorting", "label": "Enable sorting", "default": true },
    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 96
    }
  ]
}
{% endschema %}
