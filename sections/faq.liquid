<section
  class="section-padded scheme scheme--{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="editorial{% if section.settings.layout == 'stacked' %} editorial--stacked{% endif %}" style="{% if section.settings.layout == 'stacked' %}display: block;{% endif %}">
      <div class="editorial__content reveal" style="{% if section.settings.layout == 'stacked' %}max-width: 46rem; margin-inline: auto; text-align: center; align-items: center;{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow{% if section.settings.layout != 'stacked' %} eyebrow--ruled{% endif %}">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <p class="lede">{{ section.settings.text }}</p>
        {%- endif -%}

        {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
          <a href="{{ section.settings.link_url }}" class="link-arrow">
            {{ section.settings.link_label }}
            {% render 'icon', name: 'arrow-right' %}
          </a>
        {%- endif -%}
      </div>

      <div class="accordion reveal" style="--reveal-delay: 100ms;{% if section.settings.layout == 'stacked' %} max-width: 46rem; margin: 2.5rem auto 0;{% endif %}">
        {%- for block in section.blocks -%}
          <details class="accordion__item" {{ block.shopify_attributes }}>
            <summary class="accordion__summary">
              {{ block.settings.question }}
              <span class="accordion__icon" aria-hidden="true"></span>
            </summary>
            <div class="accordion__panel rte" style="text-align: left;">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Questions",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "Answer only what you can answer truthfully. An empty question is better than an invented one."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "parchment", "label": "Parchment" },
        { "value": "white", "label": "White" },
        { "value": "neutral", "label": "Neutral grey" },
        { "value": "alt", "label": "Warm parchment" }
      ],
      "default": "parchment"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "split", "label": "Heading beside the questions" },
        { "value": "stacked", "label": "Heading above the questions" }
      ],
      "default": "split"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Client care" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions we are often asked" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Write to us" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How should I care for my piece?" },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Describe the care your materials actually need.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Questions",
      "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
