{%- liquid
  assign image = section.settings.image
  assign scheme = section.settings.color_scheme
  if image != blank
    assign scheme = 'dark'
  endif
-%}

<section
  class="hero hero--full hero--center scheme scheme--{{ scheme }}"
  style="--scrim: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  {%- if image != blank -%}
    <div class="hero__media">
      <img
        src="{{ image | image_url: width: 1800 }}"
        srcset="{{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1400 }} 1400w, {{ image | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        alt=""
        width="{{ image.width }}"
        height="{{ image.height }}"
        loading="eager"
        fetchpriority="high"
      >
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>
  {%- endif -%}

  <div class="hero__inner page-width">
    <div class="hero__content hero__content--center">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name }}" style="line-height: 0;">
        {%- if scheme == 'dark' or scheme == 'sage' -%}
          {% render 'logo', variant: 'light', width: 460, class: 'brand-lockup' %}
        {%- else -%}
          {% render 'logo', variant: 'dark', width: 460, class: 'brand-lockup' %}
        {%- endif -%}
      </a>

      {%- if section.settings.heading != blank -%}
        <h1 class="h2">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="lede" style="max-width: 32rem;">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- if section.settings.show_newsletter -%}
        {%- form 'customer', class: 'newsletter__form', id: 'password-newsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="form-status form-status--success">{{ 'general.newsletter.success' | t }}</p>
          {%- else -%}
            <div class="field">
              <input
                type="email"
                id="password-newsletter-email"
                name="contact[email]"
                class="field__input"
                placeholder=" "
                autocomplete="email"
                required
              >
              <label class="field__label" for="password-newsletter-email">
                {{ 'general.newsletter.email_placeholder' | t }}
              </label>
            </div>
            <button type="submit" class="btn btn--primary">
              <span class="btn__label">{{ 'general.newsletter.submit' | t }}</span>
            </button>
          {%- endif -%}
        {%- endform -%}
      {%- endif -%}

      <details class="accordion__item" style="border: 0; margin-top: 1rem;">
        <summary class="link" style="display: inline-block;">
          {{ 'general.password_page.login_password_button' | t }}
        </summary>

        <div style="margin-top: 1.25rem; max-width: 22rem; margin-inline: auto;">
          {%- form 'storefront_password', class: 'customer__form' -%}
            {%- if form.errors -%}
              <p class="field__error">{{ 'general.password_page.login_form_error' | t }}</p>
            {%- endif -%}

            <div class="field">
              <input
                type="password"
                id="storefront-password"
                name="password"
                class="field__input"
                placeholder=" "
                autocomplete="current-password"
              >
              <label class="field__label" for="storefront-password">
                {{ 'general.password_page.login_form_password_label' | t }}
              </label>
            </div>

            <button type="submit" class="btn btn--outline btn--full">
              <span class="btn__label">{{ 'general.password_page.login_form_submit' | t }}</span>
            </button>
          {%- endform -%}
        </div>
      </details>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme when there is no image",
      "options": [
        { "value": "parchment", "label": "Parchment" },
        { "value": "alt", "label": "Warm parchment" },
        { "value": "dark", "label": "Atelier black" },
        { "value": "sage", "label": "Botanical sage" }
      ],
      "default": "alt"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Shade behind the text",
      "default": 45
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening shortly" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "The first collection is being finished by hand. Leave your address and we will write to you when it is ready."
    },
    { "type": "checkbox", "id": "show_newsletter", "label": "Collect email addresses", "default": true }
  ]
}
{% endschema %}
