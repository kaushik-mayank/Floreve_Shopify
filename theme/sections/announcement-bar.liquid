{%- liquid
  assign slides = section.blocks | where: 'type', 'message'
-%}

{%- if slides.size > 0 -%}
  <div
    class="announcement scheme scheme--{{ section.settings.color_scheme }}"
    data-announcement
    data-interval="{{ section.settings.interval | times: 1000 }}"
  >
    <div class="page-width">
      <div class="announcement__inner">
        {%- if section.settings.show_locale_note and section.settings.locale_note != blank -%}
          <span class="announcement__aside">{{ section.settings.locale_note }}</span>
        {%- endif -%}

        <div class="announcement__viewport" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
          {%- for block in slides -%}
            <p
              class="announcement__slide{% if forloop.first %} is-active{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
            </p>
          {%- endfor -%}
        </div>

        {%- if section.settings.aside_text != blank -%}
          <span class="announcement__aside announcement__aside--end">{{ section.settings.aside_text }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "aside",
  "class": "announcement-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "parchment", "label": "Parchment" },
        { "value": "alt", "label": "Warm parchment" },
        { "value": "dark", "label": "Atelier black" },
        { "value": "sage", "label": "Botanical sage" }
      ],
      "default": "alt"
    },
    {
      "type": "range",
      "id": "interval",
      "min": 4,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Seconds between messages",
      "default": 6
    },
    {
      "type": "header",
      "content": "Side notes"
    },
    {
      "type": "paragraph",
      "content": "Shown either side of the message on large screens. Leave empty to centre the message alone."
    },
    {
      "type": "checkbox",
      "id": "show_locale_note",
      "label": "Show the left-hand note",
      "default": true
    },
    {
      "type": "text",
      "id": "locale_note",
      "label": "Left-hand note",
      "default": "Maison de Joaillerie"
    },
    {
      "type": "text",
      "id": "aside_text",
      "label": "Right-hand note",
      "default": "Shipping worldwide"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message",
          "default": "Each piece is finished by hand in the atelier"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "default": {
    "settings": {},
    "blocks": [
      { "type": "message", "settings": { "text": "Each piece is finished by hand in the atelier" } },
      { "type": "message", "settings": { "text": "Complimentary presentation box with every order" } }
    ]
  },
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
