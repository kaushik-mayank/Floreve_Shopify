<section
  class="section-padded scheme scheme--{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      alignment: section.settings.alignment,
      link_url: section.settings.link_url,
      link_label: section.settings.link_label
    %}

    <div class="grid" style="--cols: 1; --cols-md: 2; --cols-lg: {{ section.blocks.size | at_most: 4 | at_least: 1 }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign block_collection = block.settings.collection
          assign tile_image = block.settings.image | default: block_collection.featured_image
          assign tile_title = block.settings.title | default: block_collection.title
          assign tile_url = block.settings.link | default: block_collection.url
        -%}

        <a
          href="{{ tile_url | default: routes.all_products_collection_url }}"
          class="collection-tile media--{{ section.settings.image_ratio }} reveal"
          style="--reveal-delay: {{ forloop.index0 | times: 90 }}ms;"
          {{ block.shopify_attributes }}
        >
          {%- if tile_image != blank -%}
            <div class="media media--{{ section.settings.image_ratio }}{% if settings.enable_image_zoom %} media--zoom{% endif %}" style="position: absolute; inset: 0;">
              <img
                src="{{ tile_image | image_url: width: 900 }}"
                srcset="{{ tile_image | image_url: width: 500 }} 500w, {{ tile_image | image_url: width: 900 }} 900w, {{ tile_image | image_url: width: 1300 }} 1300w"
                sizes="(min-width: 990px) 30vw, (min-width: 750px) 45vw, 100vw"
                alt=""
                width="{{ tile_image.width }}"
                height="{{ tile_image.height }}"
                loading="lazy"
              >
            </div>
          {%- else -%}
            <div class="placeholder-media" style="position: absolute; inset: 0;">
              {{ 'collection-1' | placeholder_svg_tag }}
            </div>
          {%- endif -%}

          <span class="collection-tile__scrim" aria-hidden="true"></span>

          <span class="collection-tile__content">
            <span class="collection-tile__title">{{ tile_title | default: 'Collection' }}</span>

            {%- if section.settings.show_count and block_collection != blank -%}
              <span class="collection-tile__count">
                {{ 'collections.general.items_with_count' | t: count: block_collection.products_count }}
              </span>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <span class="collection-tile__count">{{ block.settings.text }}</span>
            {%- endif -%}

            <span class="collection-tile__cue">
              {{ section.settings.cue_label }}
              {% render 'icon', name: 'arrow-right' %}
            </span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection showcase",
  "tag": "div",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "parchment", "label": "Parchment" },
        { "value": "white", "label": "White" },
        { "value": "alt", "label": "Warm parchment" },
        { "value": "dark", "label": "Atelier black" }
      ],
      "default": "parchment"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Collections"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Where would you like to begin?"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Heading layout",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Centred" },
        { "value": "split", "label": "Left, with the link on the right" }
      ],
      "default": "split"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "All collections"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Tile shape",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "tall", "label": "Tall" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "tall"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show how many pieces each collection holds",
      "default": true
    },
    {
      "type": "text",
      "id": "cue_label",
      "label": "Hover cue",
      "default": "Explore"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Falls back to the collection image set in Shopify admin."
        },
        { "type": "text", "id": "title", "label": "Title", "info": "Falls back to the collection name." },
        { "type": "text", "id": "text", "label": "Short line" },
        { "type": "url", "id": "link", "label": "Link", "info": "Falls back to the collection page." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection showcase",
      "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }]
    }
  ]
}
{% endschema %}
