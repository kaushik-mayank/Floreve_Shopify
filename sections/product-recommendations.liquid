{%- liquid
  assign limit = section.settings.products_to_show
  assign recommendation_url = routes.product_recommendations_url
    | append: '?section_id='
    | append: section.id
    | append: '&product_id='
    | append: product.id
    | append: '&limit='
    | append: limit
-%}

{%- comment -%}
  Shopify populates the recommendations object only when this section is
  requested through the recommendations route, so the block fetches itself once
  it comes into view. Nothing is loaded for visitors who never scroll this far.
{%- endcomment -%}

<div data-recommendations data-url="{{ recommendation_url }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <section
      class="section-padded scheme scheme--{{ section.settings.color_scheme }}"
      style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
    >
      <div class="page-width">
        {% render 'section-header',
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          alignment: section.settings.alignment
        %}

        <div
          class="{% if section.settings.mobile_layout == 'rail' %}product-rail{% else %}product-grid{% endif %}"
          style="--rail-cols: {{ limit | at_most: 4 }}; --grid-cols-lg: {{ limit | at_most: 4 }}; --grid-cols-md: 3; --grid-cols-sm: 2;"
        >
          {%- for recommended in recommendations.products -%}
            <div class="reveal" style="--reveal-delay: {{ forloop.index0 | times: 70 }}ms;">
              {% render 'product-card', product: recommended, index: forloop.index0 %}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "You may also like",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shopify chooses these pieces automatically from what customers actually view and buy together. Nothing shows until there is real data."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "parchment", "label": "Parchment" },
        { "value": "white", "label": "White" },
        { "value": "alt", "label": "Warm parchment" }
      ],
      "default": "alt"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the composition" },
    {
      "type": "select",
      "id": "alignment",
      "label": "Heading layout",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Centred" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Pieces to show",
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile behaviour",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "rail", "label": "Swipeable rail" }
      ],
      "default": "rail"
    },
    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 96
    }
  ]
}
{% endschema %}
