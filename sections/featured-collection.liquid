{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
  assign products = collection.products
  assign heading = section.settings.heading | default: collection.title
  assign link_url = section.settings.link_url | default: collection.url
-%}

<section
  class="section-padded scheme scheme--{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: heading,
      text: section.settings.text,
      alignment: section.settings.alignment,
      link_url: link_url,
      link_label: section.settings.link_label
    %}

    {%- if products.size > 0 -%}
      <div
        class="{% if section.settings.mobile_layout == 'rail' %}product-rail{% else %}product-grid{% endif %}"
        style="--rail-cols: {{ section.settings.columns }}; --grid-cols-lg: {{ section.settings.columns }}; --grid-cols-md: {{ section.settings.columns | at_most: 3 }}; --grid-cols-sm: {{ section.settings.columns_mobile }};"
      >
        {%- for product in products limit: limit -%}
          <div class="reveal" style="--reveal-delay: {{ forloop.index0 | times: 60 | at_most: 300 }}ms;">
            {% render 'product-card', product: product, index: forloop.index0 %}
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.alignment != 'split' and section.settings.link_label != blank and link_url != blank -%}
        <div style="display: flex; justify-content: center; margin-top: clamp(2rem, 4vw, 3.5rem);">
          <a href="{{ link_url }}" class="btn btn--outline">
            <span class="btn__label">{{ section.settings.link_label }}</span>
          </a>
        </div>
      {%- endif -%}

    {%- elsif collection == blank -%}
      {%- comment -%} Nothing is chosen yet — show the shape the section will take. {%- endcomment -%}
      <div
        class="product-grid"
        style="--grid-cols-lg: {{ section.settings.columns }}; --grid-cols-md: 3; --grid-cols-sm: {{ section.settings.columns_mobile }};"
      >
        {%- for i in (1..section.settings.columns) -%}
          <div class="product-card">
            <div class="product-card__media-wrap media--{{ settings.card_image_ratio }}">
              <div class="product-card__media placeholder-media">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            </div>
            <div class="product-card__info">
              <h3 class="product-card__title">{{ 'onboarding.product_title' | t }}</h3>
              <div class="price"><span class="price__now">{{ 4900 | money }}</span></div>
            </div>
          </div>
        {%- endfor -%}
      </div>

    {%- else -%}
      <p class="lede">{{ 'collections.general.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "div",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "parchment", "label": "Parchment" },
        { "value": "white", "label": "White" },
        { "value": "neutral", "label": "Neutral grey" },
        { "value": "alt", "label": "Warm parchment" },
        { "value": "dark", "label": "Atelier black" }
      ],
      "default": "parchment"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Falls back to the collection name."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Heading layout",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Centred" },
        { "value": "split", "label": "Left, with the link on the right" }
      ],
      "default": "split"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link",
      "info": "Falls back to the collection page."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "label": "Pieces to show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile behaviour",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "rail", "label": "Swipeable rail" }
      ],
      "default": "grid"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
