{%- liquid
  assign blog = blogs[section.settings.blog]
  assign articles = blog.articles
-%}

{%- if articles.size > 0 -%}
  <section
    class="section-padded scheme scheme--{{ section.settings.color_scheme }}"
    style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
  >
    <div class="page-width">
      {% render 'section-header',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        text: section.settings.text,
        alignment: 'split',
        link_url: blog.url,
        link_label: section.settings.link_label
      %}

      <div class="grid" style="--cols: 1; --cols-md: 2; --cols-lg: {{ section.settings.posts_to_show }};">
        {%- for article in articles limit: section.settings.posts_to_show -%}
          <a
            href="{{ article.url }}"
            class="article-card reveal"
            style="--reveal-delay: {{ forloop.index0 | times: 90 }}ms;"
          >
            {%- if article.image -%}
              <div class="media media--landscape{% if settings.enable_image_zoom %} media--zoom{% endif %}">
                <img
                  src="{{ article.image | image_url: width: 900 }}"
                  srcset="{{ article.image | image_url: width: 500 }} 500w, {{ article.image | image_url: width: 900 }} 900w"
                  sizes="(min-width: 990px) 32vw, 100vw"
                  alt="{{ article.image.alt | escape }}"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                  loading="lazy"
                >
              </div>
            {%- endif -%}

            <span class="article__meta">{{ article.published_at | date: format: 'date' }}</span>
            <h3 class="article-card__title">{{ article.title }}</h3>

            {%- if section.settings.show_excerpt -%}
              <p class="article-card__excerpt">
                {{ article.excerpt_or_content | strip_html | truncatewords: 22 }}
              </p>
            {%- endif -%}

            <span class="link" style="align-self: flex-start;">{{ 'blogs.article.read_more' | t }}</span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Journal",
  "tag": "div",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "parchment", "label": "Parchment" },
        { "value": "white", "label": "White" },
        { "value": "alt", "label": "Warm parchment" }
      ],
      "default": "parchment"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the atelier" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the journal" },
    {
      "type": "range",
      "id": "posts_to_show",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Entries to show",
      "default": 3
    },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show an excerpt", "default": true },
    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 96
    }
  ],
  "presets": [{ "name": "Journal" }]
}
{% endschema %}
