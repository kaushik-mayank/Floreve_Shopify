{%- liquid
  assign image = section.settings.image
  assign scheme = section.settings.color_scheme
  if image != blank
    assign scheme = 'dark'
  endif
-%}

<section
  class="hero hero--{{ section.settings.height }} hero--center scheme scheme--{{ scheme }}"
  style="--scrim: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --focal: {{ section.settings.focal_x }}% {{ section.settings.focal_y }}%;"
>
  {%- if image != blank -%}
    <div class="hero__media">
      <img
        src="{{ image | image_url: width: 1800 }}"
        srcset="{{ image | image_url: width: 800 }} 800w, {{ image | image_url: width: 1400 }} 1400w, {{ image | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        alt="{{ image.alt | escape }}"
        width="{{ image.width }}"
        height="{{ image.height }}"
        loading="lazy"
      >
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>
  {%- endif -%}

  <div class="hero__inner page-width">
    <div class="hero__content hero__content--center reveal">
      {%- if section.settings.show_mark -%}
        {% render 'calyx', size: '2.5rem' %}
      {%- endif -%}

      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="h1 hero__title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="lede hero__text">{{ section.settings.text }}</p>
      {%- endif -%}

      <div class="hero__actions">
        {%- if section.settings.primary_label != blank -%}
          <a
            href="{{ section.settings.primary_url | default: routes.all_products_collection_url }}"
            class="btn btn--primary"
          >
            <span class="btn__label">{{ section.settings.primary_label }}</span>
          </a>
        {%- endif -%}

        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_url }}" class="btn btn--outline">
            <span class="btn__label">{{ section.settings.secondary_label }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Invitation",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "The closing note of a page — an open door rather than a hard sell."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme when there is no image",
      "options": [
        { "value": "parchment", "label": "Parchment" },
        { "value": "alt", "label": "Warm parchment" },
        { "value": "dark", "label": "Atelier black" },
        { "value": "sage", "label": "Botanical sage" },
        { "value": "blush", "label": "Pressed blush" }
      ],
      "default": "alt"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "sm", "label": "Compact" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Tall" }
      ],
      "default": "md"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Shade behind the text",
      "default": 45
    },
    {
      "type": "range",
      "id": "focal_x",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Focal point — horizontal",
      "default": 50
    },
    {
      "type": "range",
      "id": "focal_y",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Focal point — vertical",
      "default": 50
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_mark",
      "label": "Show the calyx mark",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the one that speaks for you"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Each piece is made by hand in small numbers. Take your time — and write to us if you would like to see one in person."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "First button",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "First link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Second button",
      "default": "Contact the atelier"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Second link"
    }
  ],
  "presets": [{ "name": "Invitation" }]
}
{% endschema %}
