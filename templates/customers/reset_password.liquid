<section class="section">
  <div class="page-width">
    <div class="customer">
      <div class="section-header section-header--center">
        <h1 class="section-header__title">{{ 'customer.reset_password.title' | t }}</h1>
        <p class="text-body">{{ 'customer.reset_password.subtext' | t: email: email }}</p>
      </div>

      {%- form 'reset_customer_password', class: 'customer__form', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
          <div class="form-status form-status--error">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <div class="field">
          <input
            type="password"
            id="reset-password"
            name="customer[password]"
            class="field__input"
            placeholder=" "
            autocomplete="new-password"
            required
          >
          <label class="field__label" for="reset-password">{{ 'customer.reset_password.password' | t }}</label>
        </div>

        <div class="field">
          <input
            type="password"
            id="reset-password-confirm"
            name="customer[password_confirmation]"
            class="field__input"
            placeholder=" "
            autocomplete="new-password"
            required
          >
          <label class="field__label" for="reset-password-confirm">
            {{ 'customer.reset_password.password_confirm' | t }}
          </label>
        </div>

        <button type="submit" class="btn btn--primary btn--full">
          <span class="btn__label">{{ 'customer.reset_password.submit' | t }}</span>
        </button>
      {%- endform -%}
    </div>
  </div>
</section>
