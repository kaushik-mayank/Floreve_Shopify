{%- comment -%}
  Open Graph and Twitter metadata. Everything here is drawn from Shopify data
  so nothing needs editing in Liquid when the catalogue changes.
{%- endcomment -%}

{%- liquid
  assign og_title = page_title
  assign og_description = page_description | default: shop.description | default: shop.name
  assign og_type = 'website'
  assign og_image = settings.share_image

  case request.page_type
    when 'product'
      assign og_type = 'product'
      if product.featured_media
        assign og_image = product.featured_media.preview_image
      endif
    when 'article'
      assign og_type = 'article'
      if article.image
        assign og_image = article.image
      endif
    when 'collection'
      if collection.image
        assign og_image = collection.image
      endif
  endcase

  if og_image == blank
    assign og_image = settings.logo
  endif
-%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if og_image -%}
  <meta property="og:image" content="http:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="{{ og_image.width | at_most: 1200 }}">
  <meta property="og:image:height" content="{{ og_image.height | at_most: 1200 }}">
  {%- if og_image.alt -%}
    <meta property="og:image:alt" content="{{ og_image.alt | escape }}">
  {%- endif -%}
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="product:price:amount" content="{{ product.price | divided_by: 100.0 }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if og_image -%}
  <meta name="twitter:image" content="https:{{ og_image | image_url: width: 1200 }}">
{%- endif -%}
