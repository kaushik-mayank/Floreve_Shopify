{%- paginate blog.articles by section.settings.posts_per_page -%}
  <section
    class="section-padded scheme scheme--{{ section.settings.color_scheme }}"
    style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
  >
    <div class="page-width">
      <div class="section-header section-header--center reveal">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h1 class="section-header__title">{{ blog.title }}</h1>
        {%- if section.settings.text != blank -%}
          <p class="lede">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      {%- if blog.articles.size > 0 -%}
        <div class="grid" style="--cols: 1; --cols-md: 2; --cols-lg: {{ section.settings.columns }};">
          {%- for article in blog.articles -%}
            <a
              href="{{ article.url }}"
              class="article-card reveal"
              style="--reveal-delay: {{ forloop.index0 | modulo: 3 | times: 80 }}ms;"
            >
              {%- if article.image -%}
                <div class="media media--landscape{% if settings.enable_image_zoom %} media--zoom{% endif %}">
                  <img
                    src="{{ article.image | image_url: width: 900 }}"
                    srcset="{{ article.image | image_url: width: 500 }} 500w, {{ article.image | image_url: width: 900 }} 900w"
                    sizes="(min-width: 990px) 32vw, 100vw"
                    alt="{{ article.image.alt | escape }}"
                    width="{{ article.image.width }}"
                    height="{{ article.image.height }}"
                    loading="lazy"
                  >
                </div>
              {%- endif -%}

              <span class="article__meta">{{ article.published_at | date: format: 'date' }}</span>
              <h2 class="article-card__title">{{ article.title }}</h2>
              <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
              <span class="link" style="align-self: flex-start;">{{ 'blogs.article.read_more' | t }}</span>
            </a>
          {%- endfor -%}
        </div>

        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Journal",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "parchment", "label": "Parchment" },
        { "value": "white", "label": "White" },
        { "value": "alt", "label": "Warm parchment" }
      ],
      "default": "parchment"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Journal" },
    { "type": "textarea", "id": "text", "label": "Text" },
    {
      "type": "range",
      "id": "posts_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "label": "Entries per page",
      "default": 9
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 96
    }
  ]
}
{% endschema %}
