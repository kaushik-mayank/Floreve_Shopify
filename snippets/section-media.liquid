{%- comment -%}
  Section media, from whichever source the merchant has.

  Three routes, in priority order:

  1. video_asset  — a file in assets/, e.g. hero-video.mp4
  2. image        — an image chosen in the theme editor
  3. image_asset  — a filename in assets/, e.g. homepage-banner.png

  Both image routes go through Shopify's CDN, so a heavy source file is
  resized and format-converted before it reaches the browser rather than being
  served at full weight. Asset images use asset_img_url for exactly that
  reason: a 5 MB PNG in the repository still arrives as an appropriately sized
  image.

  The video never autoplays from markup. It carries a poster and preload="none",
  and theme.js starts it only on a large screen, with motion allowed and no
  Data Saver — so phones get the still and never pay for the download.

  Accepts:
  - image, image_asset, video_asset, poster_asset
  - alt      accessible description
  - sizes    responsive sizes attribute, defaults to full bleed
  - loading  'eager' above the fold, otherwise lazy
  - focal    object-position, e.g. "50% 40%"
{%- endcomment -%}

{%- liquid
  assign media_sizes = sizes | default: '100vw'
  assign media_loading = loading | default: 'lazy'
  assign media_focal = focal | default: '50% 50%'
-%}

{%- if video_asset != blank -%}
  <video
    class="section-media__video"
    {% if poster_asset != blank %}poster="{{ poster_asset | asset_img_url: '1600x' }}"{% endif %}
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    tabindex="-1"
    data-lazy-video
    data-src="{{ video_asset | asset_url }}"
    style="object-position: {{ media_focal }};"
  ></video>

{%- elsif image != blank -%}
  <img
    class="section-media__image"
    src="{{ image | image_url: width: 1600 }}"
    srcset="
      {{ image | image_url: width: 600 }} 600w,
      {{ image | image_url: width: 900 }} 900w,
      {{ image | image_url: width: 1400 }} 1400w,
      {{ image | image_url: width: 1900 }} 1900w,
      {{ image | image_url: width: 2400 }} 2400w
    "
    sizes="{{ media_sizes }}"
    alt="{{ image.alt | default: alt | escape }}"
    width="{{ image.width }}"
    height="{{ image.height }}"
    loading="{{ media_loading }}"
    {% if media_loading == 'eager' %}fetchpriority="high"{% endif %}
    style="object-position: {{ media_focal }};"
  >

{%- elsif image_asset != blank -%}
  <img
    class="section-media__image"
    src="{{ image_asset | asset_img_url: '1600x' }}"
    srcset="
      {{ image_asset | asset_img_url: '600x' }} 600w,
      {{ image_asset | asset_img_url: '900x' }} 900w,
      {{ image_asset | asset_img_url: '1400x' }} 1400w,
      {{ image_asset | asset_img_url: '1900x' }} 1900w,
      {{ image_asset | asset_img_url: '2400x' }} 2400w
    "
    sizes="{{ media_sizes }}"
    alt="{{ alt | escape }}"
    loading="{{ media_loading }}"
    {% if media_loading == 'eager' %}fetchpriority="high"{% endif %}
    style="object-position: {{ media_focal }};"
  >
{%- endif -%}
