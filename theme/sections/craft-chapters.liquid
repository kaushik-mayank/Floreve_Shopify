<section
  class="section-padded scheme scheme--{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      alignment: section.settings.alignment
    %}

    <div class="chapters" style="--chapter-cols: {{ section.blocks.size | at_most: 4 | at_least: 1 }};">
      {%- for block in section.blocks -%}
        <article class="chapter reveal" style="--reveal-delay: {{ forloop.index0 | times: 90 }}ms;" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="chapter__media media media--{{ section.settings.image_ratio }}{% if settings.enable_image_zoom %} media--zoom{% endif %} media-zoom-parent">
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1100 }} 1100w"
                sizes="(min-width: 750px) 30vw, 100vw"
                alt="{{ block.settings.image.alt | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            </div>
          {%- endif -%}

          {%- if section.settings.show_index -%}
            <span class="chapter__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <h3 class="chapter__title">{{ block.settings.title }}</h3>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <p class="chapter__text">{{ block.settings.text }}</p>
          {%- endif -%}

          {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
            <a href="{{ block.settings.link_url }}" class="link" style="align-self: flex-start;">
              {{ block.settings.link_label }}
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Chapters",
  "tag": "div",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "parchment", "label": "Parchment" },
        { "value": "white", "label": "White" },
        { "value": "alt", "label": "Warm parchment" },
        { "value": "dark", "label": "Atelier black" },
        { "value": "sage", "label": "Botanical sage" }
      ],
      "default": "alt"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The making"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From a living thing to a lasting one"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Heading layout",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Centred" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_index",
      "label": "Number the chapters",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "landscape"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 112
    }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Chapter",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "The study" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "A flower is photographed, measured and drawn before a single line is committed to metal."
        },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link_url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Chapters",
      "blocks": [
        {
          "type": "chapter",
          "settings": {
            "title": "The study",
            "text": "A flower is photographed, measured and drawn before a single line is committed to metal."
          }
        },
        {
          "type": "chapter",
          "settings": {
            "title": "The bench",
            "text": "Forms are shaped, soldered and set by hand, one piece at a time."
          }
        },
        {
          "type": "chapter",
          "settings": {
            "title": "The finish",
            "text": "Surfaces are polished by hand until the light moves across them the way it moves across a petal."
          }
        }
      ]
    }
  ]
}
{% endschema %}
