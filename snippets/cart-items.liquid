{%- comment -%}
  The line items in the bag. Shared by the slide-out bag and the bag page so
  both always behave identically.

  Accepts:
  - compact: true inside the drawer
{%- endcomment -%}

<ul class="cart-items" role="list">
  {%- for item in cart.items -%}
    <li class="cart-item" data-cart-item data-line="{{ forloop.index }}">
      <a href="{{ item.url }}" class="cart-item__media" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          <img
            src="{{ item.image | image_url: width: 220 }}"
            srcset="{{ item.image | image_url: width: 110 }} 1x, {{ item.image | image_url: width: 220 }} 2x"
            alt="{{ item.image.alt | default: item.product.title | escape }}"
            width="110"
            height="110"
            loading="lazy"
          >
        {%- else -%}
          <span class="placeholder-media">{{ 'product-1' | placeholder_svg_tag }}</span>
        {%- endif -%}
      </a>

      <div class="cart-item__details">
        <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>

        {%- unless item.product.has_only_default_variant -%}
          <span class="cart-item__variant">{{ item.variant.title }}</span>
        {%- endunless -%}

        {%- if item.selling_plan_allocation -%}
          <span class="cart-item__variant">{{ item.selling_plan_allocation.selling_plan.name }}</span>
        {%- endif -%}

        {%- if item.properties -%}
          {%- for property in item.properties -%}
            {%- liquid
              assign first_character = property.first | slice: 0
              if property.last == blank or first_character == '_'
                continue
              endif
            -%}
            <span class="cart-item__variant">{{ property.first }}: {{ property.last }}</span>
          {%- endfor -%}
        {%- endif -%}

        <div class="price">
          {%- if item.original_price > item.final_price -%}
            <s class="price__was">{{ item.original_price | money }}</s>
            <span class="price__now price__now--sale">{{ item.final_price | money }}</span>
          {%- else -%}
            <span class="price__now">{{ item.final_price | money }}</span>
          {%- endif -%}
        </div>

        {%- if item.line_level_discount_allocations.size > 0 -%}
          {%- for allocation in item.line_level_discount_allocations -%}
            <span class="cart-item__discount">
              {{ allocation.discount_application.title }} (&minus;{{ allocation.amount | money }})
            </span>
          {%- endfor -%}
        {%- endif -%}

        {%- if item.quantity > item.variant.inventory_quantity and item.variant.inventory_management != blank and item.variant.inventory_policy == 'deny' -%}
          <span class="field__error">
            {{ 'sections.cart.quantity_error' | t: quantity: item.variant.inventory_quantity }}
          </span>
        {%- endif -%}
      </div>

      <div class="cart-item__controls">
        {%- liquid
          assign scope_suffix = 'page'
          if compact
            assign scope_suffix = 'drawer'
          endif
          assign quantity_id = 'cart-quantity-' | append: scope_suffix | append: '-' | append: forloop.index
        -%}
        {% render 'quantity-input',
          id: quantity_id,
          value: item.quantity,
          min: 0,
          label: item.product.title,
          line: forloop.index
        %}

        {%- unless compact -%}
          <span class="cart-item__price">{{ item.final_line_price | money }}</span>
        {%- endunless -%}

        <a
          href="{{ item.url_to_remove }}"
          class="cart-item__remove"
          data-cart-remove
          data-line="{{ forloop.index }}"
          aria-label="{{ 'sections.cart.remove_item' | t: title: item.product.title }}"
        >
          {{ 'sections.cart.remove' | t }}
        </a>
      </div>
    </li>
  {%- endfor -%}
</ul>
