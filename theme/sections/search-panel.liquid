{%- liquid
  assign resources = 'product'
  if settings.predictive_search_collections
    assign resources = resources | append: ',collection'
  endif
  if settings.predictive_search_pages
    assign resources = resources | append: ',page,article'
  endif
-%}

<div
  class="search-panel"
  id="search-panel"
  data-search-panel
  {% if settings.predictive_search %}data-predictive{% endif %}
  data-resources="{{ resources }}"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'general.search.search' | t }}"
>
  <div class="page-width">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-panel__form">
      <label class="visually-hidden" for="search-panel-input">{{ 'general.search.search' | t }}</label>
      <input
        type="search"
        id="search-panel-input"
        name="q"
        class="search-panel__input"
        placeholder="{{ 'general.search.placeholder' | t }}"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        data-search-input
        data-panel-initial-focus
      >
      <input type="hidden" name="options[prefix]" value="last">

      {%- comment -%} Clearing the field and closing the panel are different acts. {%- endcomment -%}
      <button
        type="button"
        class="link link--muted"
        data-search-clear
        hidden
      >
        {{ 'general.search.reset' | t }}
      </button>

      <button type="button" class="icon-button" data-panel-close aria-label="{{ 'general.search.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </form>

    <div class="search-panel__results" data-search-results hidden></div>

    {%- if section.blocks.size > 0 -%}
      <div class="search-panel__results" data-search-default>
        <div class="grid" style="--cols: 1; --cols-md: 2;">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'links' -%}
                <div class="search-panel__section" {{ block.shopify_attributes }}>
                  <div class="search-panel__heading">
                    <span class="eyebrow">{{ block.settings.heading }}</span>
                  </div>
                  <ul class="search-suggestion-list" role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a href="{{ link.url }}" class="search-suggestion">
                          <span class="search-suggestion__title">{{ link.title }}</span>
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>

              {%- when 'products' -%}
                {%- if block.settings.collection != blank -%}
                  <div class="search-panel__section" {{ block.shopify_attributes }}>
                    <div class="search-panel__heading">
                      <span class="eyebrow">{{ block.settings.heading }}</span>
                    </div>
                    <ul class="search-suggestion-list" role="list">
                      {%- for product in block.settings.collection.products limit: 4 -%}
                        <li>
                          <a href="{{ product.url }}" class="search-suggestion">
                            {%- if product.featured_media -%}
                              <span class="search-suggestion__media media media--square">
                                <img
                                  src="{{ product.featured_media | image_url: width: 160 }}"
                                  alt=""
                                  width="60"
                                  height="60"
                                  loading="lazy"
                                >
                              </span>
                            {%- endif -%}
                            <span>
                              <span class="search-suggestion__title">{{ product.title }}</span>
                              <span class="search-suggestion__meta">{{ product.price | money }}</span>
                            </span>
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Search panel",
  "max_blocks": 2,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shown before the visitor types. Prediction settings live in Theme settings › Search."
    }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Suggested links",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Explore" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "products",
      "name": "Suggested pieces",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Signature pieces" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "links",
        "settings": {
          "heading": "Explore",
          "menu": "main-menu"
        }
      }
    ]
  }
}
{% endschema %}
